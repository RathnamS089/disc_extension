{
  "manifest_version": 3,
  "name": "Disc Deck",
  "version": "1.0.0",
  "description": "See what's playing in your tabs as spinning 3D discs, with up next and play, pause and skip from a side panel or mini player.",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "Open Disc Deck",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png" }
  },
  "side_panel": { "default_path": "src/sidepanel/index.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["sidePanel", "storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "web_accessible_resources": [{ "resources": ["src/mini/index.html", "assets/*"], "matches": ["<all_urls>"] }],
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["hook.js"], "run_at": "document_start", "world": "MAIN" },
    { "matches": ["<all_urls>"], "js": ["bridge.js"], "run_at": "document_start" },
    { "matches": ["<all_urls>"], "js": ["mini.js"], "run_at": "document_idle" }
  ]
}
